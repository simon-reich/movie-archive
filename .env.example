# ─────────────────────────────────────────────────────────────────
# MovieArchive — Environment Variables
# Copy this file to .env and fill in all values marked <CHANGE_ME>
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Database
DB_PASSWORD=<CHANGE_ME>

# JWT — must be at least 32 characters
JWT_SECRET=<CHANGE_ME_min_32_characters_long!!>

# AES-256-GCM master key for API-key encryption — exactly 32 characters
ENCRYPTION_MASTER_KEY=<CHANGE_ME_exactly_32_characters!>

# App base URL (used in email links)
APP_BASE_URL=http://localhost

# OpenSearch (only needed if you change the default admin password)
OPENSEARCH_ADMIN_PASSWORD=Admin1234!

# SMTP (production) — leave empty to use Mailpit locally
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@moviearchive.local

# Recommended providers:
#   Brevo  — https://brevo.com  (300 mails/day free)
#   Resend — https://resend.com (3,000 mails/month free)

# ── E2E Tests (Playwright + Docker Compose full stack) ───────────────────────
# Only required when running E2E tests. Not needed for normal development.
#
# Enable test-only seed endpoint in Spring Boot:
SPRING_PROFILES_ACTIVE=

# Test user credentials (created by POST /test/setup):
TEST_USER_EMAIL=e2e@moviearchive.test
TEST_USER_PASSWORD=E2ePassword1!

# TMDB API key used for E2E film search + save flow:
# Get one at https://www.themoviedb.org/settings/api
TEST_TMDB_KEY=
